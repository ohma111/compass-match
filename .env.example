# ==== Supabase (Project Settings → API) ====
# 公開して問題ない値 (ブラウザにも埋め込まれる)。値の実体はコードに書かないこと。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 本番のURL (OAuthのリダイレクト先の組み立てに使用。末尾スラッシュなし)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==== 機能フラグ ====
# 「今から遊べる」機能。初期リリースは false のまま。
NEXT_PUBLIC_FEATURE_AVAILABLE_NOW=false
# 「今から遊べる」で人数を表示し始める閾値
NOW_LIST_MIN_USERS=30

# ※ service_role キーはこのアプリでは使用しません。絶対に NEXT_PUBLIC_ を付けて設定しないでください。
