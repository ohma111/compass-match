# ==== Supabase (Project Settings → API) ====
# 公開して問題ない値 (ブラウザにも埋め込まれる)。値の実体はコードに書かないこと。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 本番のURL (OAuthのリダイレクト先の組み立てに使用。末尾スラッシュなし)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==== 機能フラグ ====
# 「今から遊べる」機能。初期リリースは false のまま。
NEXT_PUBLIC_FEATURE_AVAILABLE_NOW=false
# 「今から遊べる」で人数を表示し始める閾値
NOW_LIST_MIN_USERS=30

# ==== サーバー専用 (v3) ====
# ユーザーID登録・引き継ぎコード・パスワード再設定で使う service_role キー。
# 絶対に NEXT_PUBLIC_ を付けないこと (ブラウザに埋め込まれてしまう)。値はコミットしない。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 有料版 (Plus) と広告。どちらも初期 OFF。ON にする前に migration 22 を本番に適用すること
NEXT_PUBLIC_FEATURE_PLUS=false
NEXT_PUBLIC_FEATURE_ADS=false
# AdSense の審査に通ったあとに入れる (ca-pub-… と、置き場所ごとの枠ID)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_LIST=
NEXT_PUBLIC_ADSENSE_SLOT_PROFILE=
